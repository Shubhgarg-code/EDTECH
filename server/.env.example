PORT=5000
NODE_ENV=development

# Database Configuration (Leave blank to use portable in-memory MongoDB in dev)
MONGODB_URI=

# Authentication Secrets
JWT_SECRET=your_jwt_secret_key_here_min_32_characters_with_numbers
JWT_EXPIRES_IN=7d

# Payment Gateway (Razorpay Sandbox/Live Credentials)
RAZORPAY_KEY_ID=your_razorpay_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here

# Frontend Application URL
CLIENT_URL=http://localhost:5173

# Storage Configuration: 'local' (development), 'b2' (Backblaze B2), or 'r2' (Cloudflare R2)
STORAGE_DRIVER=b2

# Backblaze B2 Configuration (S3-Compatible)
B2_KEY_ID=your_b2_key_id
B2_APPLICATION_KEY=your_b2_application_key
B2_BUCKET_NAME=mathematics-academy-storage
B2_ENDPOINT=https://s3.us-east-005.backblazeb2.com
B2_REGION=us-east-005

# Cloudflare R2 Configuration (Alternative S3-Compatible Driver)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=
