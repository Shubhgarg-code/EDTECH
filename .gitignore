# Dependencies
node_modules/
*/node_modules/

# Production Build outputs
dist/
dist-ssr/
client/dist/

# Environment Variables
.env
.env.local
.env.*.local
*.env
server/.env

# Allow example env files
!.env.example
!server/.env.example

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Uploaded User Content (keep uploads directory structure via .gitkeep)
server/uploads/*
!server/uploads/.gitkeep

# Operating System Files
.DS_Store
Thumbs.db

# IDE and Editor Directories
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Temporary / Scratch
tmp/
temp/
